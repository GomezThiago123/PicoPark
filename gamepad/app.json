{
  "expo": {
    "name": "PicoPark Gamepad",
    "slug": "picopark-gamepad",
    "version": "1.0.0",
    "orientation": "landscape",
    "userInterfaceStyle": "dark",
    "splash": {
      "resizeMode": "contain",
      "backgroundColor": "#1a1a2e"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#1a1a2e"
      },
      "package": "com.picopark.gamepad",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "La app necesita la cámara para escanear el código QR del juego."
        }
      ]
    ],
    "ios": {
      "bundleIdentifier": "com.picopark.gamepad"
    },
    "extra": {
      "eas": {
        "projectId": "1918880b-0ced-48e4-b519-c2d9c9739e62"
      }
    }
  }
}
